# Public canonical URL (metadata, sitemap, robots)
SITE_URL=https://armoniacapital.com

# ---- Article generator (npm run generate) ----
# Provider with built-in web search: "gemini" (Google Search grounding) or "groq" (groq/compound)
LLM_PROVIDER=groq
GEMINI_API_KEY=
# Pin a current model id from https://ai.google.dev/gemini-api/docs/models (the alias works too)
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Small model used for the "radar" (trend clustering) and for translating foreign-language news
GROQ_LIGHT_MODEL=openai/gpt-oss-20b
# Number of web-research passes per article (1 = facts only, 2 = facts + regional angles)
RESEARCH_PASSES=2
# Seconds-long pause between heavy Groq calls (free tier allows ~8,000 tokens per minute per model)
GROQ_COOLDOWN_MS=62000

# Images (the generator tries Pexels first, then Pixabay)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Articles per run, optional fixed category, and review mode
ARTICLES_PER_RUN=1
# CATEGORY=islamic-finance
# true = write to data/drafts.json for manual review instead of publishing
DRAFT_MODE=false

# ---- Email briefing (Resend) ----
RESEND_API_KEY=
# Segment that holds your confirmed subscribers (Resend dashboard > Segments)
RESEND_SEGMENT_ID=
# Must use the domain you verified in Resend
EMAIL_FROM=Armonia Capital <briefing@armoniacapital.com>
# Any long random string; signs the confirmation links (Cloudflare secret)
SUBSCRIBE_SECRET=

# Optional: free CoinGecko "Demo" API key (coingecko.com/en/api) makes live crypto prices more reliable on Cloudflare
COINGECKO_API_KEY=
